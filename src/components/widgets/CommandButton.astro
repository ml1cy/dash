---
import BaseWidget from './BaseWidget.astro';

interface Props {
  title?: string;
  badge?: string;
  cols?: number;
  rows?: number;
  label?: string;
  endpoint?: string;
  method?: string;
  body?: unknown;
}

const {
  title,
  badge,
  cols,
  rows,
  label = 'Run command',
  endpoint = '/api/proxy',
  method = 'POST',
  body = {},
} = Astro.props;
---

<BaseWidget title={title} badge={badge} cols={cols} rows={rows}>
  <button type="button" data-endpoint={endpoint} data-method={method} data-body={JSON.stringify(body)}>{label}</button>
</BaseWidget>

<script>
  document.querySelectorAll('button[data-endpoint]').forEach((button) => {
    button.addEventListener('click', async () => {
      const endpoint = button.getAttribute('data-endpoint');
      if (!endpoint) {
        return;
      }

      const method = (button.getAttribute('data-method') || 'POST').toUpperCase();
      const body = button.getAttribute('data-body') || '{}';
      const bodyAllowed = method !== 'GET' && method !== 'HEAD';
      await fetch(endpoint, bodyAllowed
        ? {
            method,
            headers: { 'content-type': 'application/json' },
            body,
          }
        : { method });
    });
  });
</script>
