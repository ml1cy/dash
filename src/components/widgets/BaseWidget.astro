---
interface Props {
  title?: string;
  badge?: string;
  cols?: number;
  rows?: number;
}

const { title, badge, cols = 1, rows = 1 } = Astro.props;
---

<article class="widget" style={`grid-column: span ${cols}; grid-row: span ${rows};`}>
  {(title || badge) && (
    <header>
      {title && <h2>{title}</h2>}
      {badge && <span>{badge}</span>}
    </header>
  )}
  <slot />
</article>

<style>
  .widget { background: #111827; border: 1px solid #334155; border-radius: .75rem; padding: 1rem; }
  header { display: flex; justify-content: space-between; align-items: center; margin-bottom: .75rem; }
  h2 { margin: 0; font-size: 1rem; }
  span { font-size: .75rem; background: #1e293b; padding: .2rem .5rem; border-radius: 999px; }
</style>
